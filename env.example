# Copy to .env (ignored by version control). Only the LLM call needs a key; ingest/index run offline.

# Any litellm model string. Examples:
#   anthropic/claude-sonnet-5        (default)
#   openai/gpt-4o
#   groq/llama-3.3-70b-versatile
#   ollama/llama3                    (local, no key)
SPARRING_MODEL=anthropic/claude-sonnet-5

# Key for the provider above. Leave the ones you do not use empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional paths
# SPARRING_DATA_DIR=data
# SPARRING_PERSONAS_DIR=personas
